<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Jarvis hotword: on-device only (Porcupine/Vosk never transmit).
         Runtime grant is asked when listening is enabled, never at install.
         Android shows a mic indicator while listening — by OS design. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".RmmApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.RMM"
        android:usesCleartextTraffic="true"
        android:allowBackup="false">
        <!-- Cleartext is for LAN testing over plain HTTP; the internet
             leg should be HTTPS (tunnel or RMM_UI_TLS_CERT). -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".SetupActivity"
            android:exported="false" />
        <service
            android:name=".RmmService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".HotwordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <receiver
            android:name=".RmmWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
